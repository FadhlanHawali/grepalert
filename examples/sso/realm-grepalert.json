{
  "realm": "grepalert",
  "displayName": "grepalert demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "passwordPolicy": "length(12) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "groups": [
    {"name": "grepalert-admins"},
    {"name": "db-team"},
    {"name": "web-team"}
  ],
  "clients": [{
    "clientId": "grepalert-dashboard",
    "name": "grepalert dashboard",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "clientAuthenticatorType": "client-secret",
    "secret": "${GREPALERT_OIDC_CLIENT_SECRET}",
    "standardFlowEnabled": true,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": false,
    "redirectUris": ["http://localhost:9420/auth/callback"],
    "webOrigins": ["http://localhost:9420"],
    "attributes": {
      "pkce.code.challenge.method": "S256",
      "post.logout.redirect.uris": "http://localhost:9420/login"
    },
    "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
    "protocolMappers": [{
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "config": {
        "claim.name": "groups",
        "full.path": "false",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }]
  }],
  "users": [
    {"username": "ops-admin", "email": "ops@example.com", "firstName": "Olivia", "lastName": "Ops",
     "emailVerified": true, "enabled": true, "groups": ["grepalert-admins"],
     "credentials": [{"type": "password", "value": "${DEMO_PASSWORD_OPS}", "temporary": false}]},
    {"username": "alice", "email": "alice@example.com", "firstName": "Alice", "lastName": "Database",
     "emailVerified": true, "enabled": true, "groups": ["db-team"],
     "credentials": [{"type": "password", "value": "${DEMO_PASSWORD_ALICE}", "temporary": false}]},
    {"username": "carol", "email": "carol@example.com", "firstName": "Carol", "lastName": "Web",
     "emailVerified": true, "enabled": true, "groups": ["web-team"],
     "credentials": [{"type": "password", "value": "${DEMO_PASSWORD_CAROL}", "temporary": false}]},
    {"username": "bob", "email": "bob@example.com", "firstName": "Bob", "lastName": "Newcomer",
     "emailVerified": true, "enabled": true,
     "credentials": [{"type": "password", "value": "${DEMO_PASSWORD_BOB}", "temporary": false}]}
  ]
}
